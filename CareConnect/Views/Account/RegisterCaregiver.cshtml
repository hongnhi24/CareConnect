@model CareConnect.ViewModels.RegisterCaregiverViewModel

@{
    ViewData["Title"] = "Đăng ký người chăm sóc";
}

<section class="caregiver-register-page">
    <div class="caregiver-register-heading">
        <div class="caregiver-heading-icon">
            <i class="bi bi-person-plus"></i>
        </div>

        <h1>Tạo tài khoản CareConnect</h1>

        <p>
            Bắt đầu hành trình chăm sóc người thân yêu cùng chúng tôi
        </p>
    </div>

    <div class="caregiver-register-card">
        <div class="caregiver-register-title">
            <a asp-controller="Account"
               asp-action="Register"
               class="caregiver-back-button"
               aria-label="Quay lại">
                <i class="bi bi-arrow-left"></i>
            </a>

            <div>
                <h2>Đăng ký Người chăm sóc</h2>
                <p>Bước 1/3 - Thông tin cá nhân</p>
            </div>
        </div>

        <div class="caregiver-progress">
            <span class="active"></span>
            <span></span>
            <span></span>
        </div>

        <form asp-controller="Account"
              asp-action="RegisterCaregiver"
              method="post"
              class="caregiver-register-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="register-validation-summary">
            </div>

            <div class="caregiver-form-group">
                <label asp-for="HoTen"></label>

                <input asp-for="HoTen"
                       placeholder="Nguyễn Thị B"
                       autocomplete="name" />

                <span asp-validation-for="HoTen"
                      class="field-validation">
                </span>
            </div>

            <div class="caregiver-form-group">
                <label asp-for="SoDienThoai"></label>

                <input asp-for="SoDienThoai"
                       placeholder="0912 345 678"
                       autocomplete="tel"
                       inputmode="tel" />

                <span asp-validation-for="SoDienThoai"
                      class="field-validation">
                </span>
            </div>

            <div class="caregiver-form-group">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       placeholder="email@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="field-validation">
                </span>
            </div>

            <div class="caregiver-form-group">
                <label asp-for="MatKhau"></label>

                <div class="caregiver-password-wrapper">
                    <input asp-for="MatKhau"
                           id="caregiverPassword"
                           placeholder="Nhập mật khẩu"
                           autocomplete="new-password" />

                    <button type="button"
                            class="caregiver-password-toggle"
                            data-target="caregiverPassword"
                            aria-label="Hiện mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="MatKhau"
                      class="field-validation">
                </span>
            </div>

            <div class="caregiver-form-group">
                <label asp-for="XacNhanMatKhau"></label>

                <div class="caregiver-password-wrapper">
                    <input asp-for="XacNhanMatKhau"
                           id="caregiverConfirmPassword"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />

                    <button type="button"
                            class="caregiver-password-toggle"
                            data-target="caregiverConfirmPassword"
                            aria-label="Hiện mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="XacNhanMatKhau"
                      class="field-validation">
                </span>
            </div>

            <button type="submit"
                    class="caregiver-next-button">
                Tiếp tục
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll(".caregiver-password-toggle")
            .forEach(function(button) {
                button.addEventListener("click", function() {
                    const targetId = this.dataset.target;
                    const input = document.getElementById(targetId);

                    if (!input) {
                        return;
                    }

                    const isPassword = input.type === "password";

                    input.type = isPassword ? "text" : "password";

                    this.innerHTML = isPassword
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            });
    </script>
}