@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <div class="container hero-content">
        <div class="hero-badge">
            <i class="bi bi-stars"></i>
            Hơn 100 gia đình đã tin tưởng
        </div>

        <h1>
            Chăm sóc người thân yêu,
            <span>ngay tại nhà</span>
        </h1>

        <p>
            Kết nối với những người chăm sóc tận tâm, chuyên nghiệp.
            Giúp người thân của bạn luôn được quan tâm và chăm sóc
            chu đáo mỗi ngày.
        </p>

        <div class="hero-actions">
            <a href="#caregivers" class="btn btn-primary">
                Tôi cần tìm người chăm sóc
            </a>

            <a href="#how-it-works" class="btn btn-outline-light">
                Tôi muốn trở thành người chăm sóc
            </a>
        </div>

        <div class="hero-statistics">
            <div>
                <strong>100+</strong>
                <span>Gia đình tin tưởng</span>
            </div>

            <div>
                <strong>50+</strong>
                <span>Người chăm sóc</span>
            </div>

            <div>
                <strong>4.9/5</strong>
                <span>Điểm đánh giá</span>
            </div>
        </div>
    </div>
</section>

<section class="section section-white" id="how-it-works">
    <div class="container">
        <div class="section-heading">
            <span class="section-label">Quy trình đơn giản</span>

            <h2>Cách hoạt động</h2>

            <p>
                Chỉ với bốn bước đơn giản, khách hàng có thể kết nối
                với người chăm sóc phù hợp cho người thân.
            </p>
        </div>

        <div class="steps-grid">
            <article class="step-card">
                <span class="step-number">1</span>

                <div class="step-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <h3>Tạo hồ sơ</h3>

                <p>
                    Đăng ký tài khoản và tạo hồ sơ sức khỏe
                    cho người cần chăm sóc.
                </p>
            </article>

            <article class="step-card">
                <span class="step-number">2</span>

                <div class="step-icon">
                    <i class="bi bi-search"></i>
                </div>

                <h3>Chọn người chăm sóc</h3>

                <p>
                    Tìm kiếm người chăm sóc dựa trên chuyên môn,
                    kinh nghiệm và nhu cầu thực tế.
                </p>
            </article>

            <article class="step-card">
                <span class="step-number">3</span>

                <div class="step-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <h3>Đặt lịch</h3>

                <p>
                    Chọn dịch vụ, thời gian phù hợp
                    và xác nhận lịch chăm sóc.
                </p>
            </article>

            <article class="step-card">
                <span class="step-number">4</span>

                <div class="step-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>

                <h3>Theo dõi và đánh giá</h3>

                <p>
                    Theo dõi nhật ký chăm sóc
                    và gửi đánh giá sau khi hoàn thành.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section section-soft" id="services">
    <div class="container">
        <div class="section-heading">
            <span class="section-label">Dịch vụ của chúng tôi</span>

            <h2>
                Chăm sóc <span class="highlight">toàn diện</span>
                cho người thân
            </h2>

            <p>
                Các dịch vụ được thiết kế phù hợp với nhu cầu
                chăm sóc sức khỏe tại nhà.
            </p>
        </div>

        <div class="service-grid">
            <article class="service-card">
                <div class="service-icon icon-blue">
                    <i class="bi bi-heart-pulse"></i>
                </div>

                <div>
                    <h3>Chăm sóc sức khỏe toàn diện</h3>

                    <p>
                        Theo dõi huyết áp, nhịp tim, đường huyết,
                        hỗ trợ uống thuốc và sinh hoạt hằng ngày.
                    </p>
                </div>
            </article>

            <article class="service-card">
                <div class="service-icon icon-orange">
                    <i class="bi bi-person-walking"></i>
                </div>

                <div>
                    <h3>Vật lý trị liệu</h3>

                    <p>
                        Hỗ trợ phục hồi vận động,
                        cải thiện khả năng di chuyển an toàn.
                    </p>
                </div>
            </article>

            <article class="service-card">
                <div class="service-icon icon-green">
                    <i class="bi bi-chat-heart"></i>
                </div>

                <div>
                    <h3>Đồng hành tinh thần</h3>

                    <p>
                        Trò chuyện và hỗ trợ người cao tuổi
                        giảm cảm giác cô đơn trong sinh hoạt.
                    </p>
                </div>
            </article>

            <article class="service-card">
                <div class="service-icon icon-blue">
                    <i class="bi bi-journal-medical"></i>
                </div>

                <div>
                    <h3>Nhật ký sức khỏe</h3>

                    <p>
                        Ghi nhận tình trạng sức khỏe
                        sau mỗi buổi chăm sóc.
                    </p>
                </div>
            </article>

            <article class="service-card">
                <div class="service-icon icon-orange">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>
                    <h3>Người chăm sóc được xác minh</h3>

                    <p>
                        Hồ sơ, kinh nghiệm và chứng chỉ
                        được kiểm tra trước khi hoạt động.
                    </p>
                </div>
            </article>

            <article class="service-card">
                <div class="service-icon icon-green">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <h3>An toàn và bảo mật</h3>

                    <p>
                        Dữ liệu sức khỏe và thông tin cá nhân
                        được bảo vệ theo quyền truy cập.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

