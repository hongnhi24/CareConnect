@section Scripts
{
    <script>

        /* =====================================================
           VALIDATE FORM TỪ CHỐI LỊCH
        ===================================================== */

        document
            .querySelectorAll(
                "[data-reject-form]")
            .forEach(
                function(form) {

                    const reason =
                        form.querySelector(
                            "[data-reject-reason]");

                    const note =
                        form.querySelector(
                            "[data-reject-note]");

                    const hint =
                        form.querySelector(
                            "[data-reject-note-hint]");


                    function syncRejectValidation() {

                        const isOther =
                            reason?.value
                            === "Lý do khác";


                        if (note) {

                            note.required =
                                isOther;
                        }


                        hint?.classList.toggle(
                            "is-required",
                            isOther);
                    }


                    reason?.addEventListener(
                        "change",
                        syncRejectValidation);


                    syncRejectValidation();


                    form.addEventListener(
                        "submit",
                        function(event) {

                            syncRejectValidation();


                            if (!form.checkValidity()) {

                                event.preventDefault();

                                form.reportValidity();

                                return;
                            }


                            const dongY =
                                confirm(
                                    "Bạn chắc chắn muốn từ chối lịch này? "
                                    + "Lịch sẽ được trả về hàng chờ phân công.");


                            if (!dongY) {

                                event.preventDefault();
                            }
                        });

                });

    </script>
}