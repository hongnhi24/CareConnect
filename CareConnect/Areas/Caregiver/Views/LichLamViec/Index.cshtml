</div>



@section Scripts
{
    <script>

        /* =====================================================
           MODAL CHI TIẾT
        ===================================================== */

        const detailModal =
            document.getElementById(
                "scheduleDetailModal");


        const detailButtons =
            document.querySelectorAll(
                "[data-detail-button]");


        const closeModalButtons =
            document.querySelectorAll(
                "[data-close-modal]");



        function setModalText(
            id,
            value,
            fallback) {

            const element =
                document.getElementById(id);


            if (!element) {
                return;
            }


            element.textContent =
                value && value.trim()
                    ? value
                    : fallback;
        }



        function openDetailModal(button) {

            setModalText(
                "modalScheduleCode",
                `LỊCH #${button.dataset.code}`,
                "LỊCH CHĂM SÓC");


            setModalText(
                "modalPatient",
                button.dataset.patient,
                "Chưa cập nhật");


            setModalText(
                "modalHealth",
                button.dataset.health,
                "Chưa cập nhật tình trạng sức khỏe.");


            setModalText(
                "modalService",
                button.dataset.service,
                "Chưa cập nhật");


            setModalText(
                "modalStatus",
                button.dataset.status,
                "Chưa xác định");


            setModalText(
                "modalDate",
                button.dataset.date,
                "Chưa cập nhật");


            setModalText(
                "modalTime",
                button.dataset.time,
                "Chưa cập nhật");


            setModalText(
                "modalCustomer",
                button.dataset.customer,
                "Chưa cập nhật");


            setModalText(
                "modalPhone",
                button.dataset.phone,
                "Chưa cập nhật");


            setModalText(
                "modalPrice",
                button.dataset.price,
                "0đ");


            setModalText(
                "modalAddress",
                button.dataset.address,
                "Chưa cập nhật");


            setModalText(
                "modalNote",
                button.dataset.note,
                "Không có ghi chú.");


            detailModal?.classList.add(
                "is-open");


            detailModal?.setAttribute(
                "aria-hidden",
                "false");


            document.body.classList.add(
                "cg-modal-open");
        }



        function closeDetailModal() {

            detailModal?.classList.remove(
                "is-open");


            detailModal?.setAttribute(
                "aria-hidden",
                "true");


            document.body.classList.remove(
                "cg-modal-open");
        }



        detailButtons.forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        openDetailModal(
                            button);
                    });
            });



        closeModalButtons.forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    closeDetailModal);
            });



        document.addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Escape") {

                    closeDetailModal();
                }
            });



        /* =====================================================
           TOAST
        ===================================================== */

        const scheduleToast =
            document.getElementById(
                "scheduleToast");


        const closeScheduleToast =
            document.getElementById(
                "closeScheduleToast");



        function hideScheduleToast() {

            if (!scheduleToast) {
                return;
            }


            scheduleToast.classList.add(
                "is-hiding");


            setTimeout(
                function() {

                    scheduleToast.remove();

                },
                250);
        }



        closeScheduleToast?.addEventListener(
            "click",
            hideScheduleToast);



        if (scheduleToast) {

            setTimeout(
                hideScheduleToast,
                4500);
        }



        /* =====================================================
           TỪ CHỐI LỊCH
           CLIENT VALIDATION
        ===================================================== */

        document
            .querySelectorAll(
                "[data-reject-form]")
            .forEach(
                function(form) {


                    const reason =
                        form.querySelector(
                            "[data-reject-reason]");


                    const note =
                        form.querySelector(
                            "[data-reject-note]");


                    const hint =
                        form.querySelector(
                            "[data-reject-note-hint]");



                    function updateRejectValidation() {

                        const isOther =
                            reason?.value
                            === "Lý do khác";


                        if (note) {

                            note.required =
                                isOther;
                        }


                        if (hint) {

                            hint.classList.toggle(
                                "is-required",
                                isOther);


                            hint.textContent =
                                isOther
                                    ? "Vui lòng nhập ghi chú khi chọn “Lý do khác”."
                                    : "Không bắt buộc, trừ khi chọn “Lý do khác”.";
                        }
                    }



                    reason?.addEventListener(
                        "change",
                        updateRejectValidation);



                    form.addEventListener(
                        "submit",
                        function(event) {


                            updateRejectValidation();


                            if (!form.checkValidity()) {

                                event.preventDefault();

                                form.reportValidity();

                                return;
                            }


                            const confirmed =
                                confirm(
                                    "Bạn chắc chắn muốn từ chối lịch này? "
                                    + "Sau khi từ chối, lịch sẽ được trả về "
                                    + "hàng chờ phân công.");


                            if (!confirmed) {

                                event.preventDefault();
                            }
                        });



                    updateRejectValidation();

                });



        /* =====================================================
           ĐÓNG FORM TỪ CHỐI
        ===================================================== */

        document
            .querySelectorAll(
                "[data-close-reject]")
            .forEach(
                function(button) {

                    button.addEventListener(
                        "click",
                        function() {

                            const details =
                                button.closest(
                                    "details");


                            details?.removeAttribute(
                                "open");
                        });
                });

    </script>
}